<Window x:Class="AppProxyBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="App Proxy Bridge" Width="1140" Height="820" MinWidth="1000" MinHeight="720" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Icon="Assets/app.ico" WindowStartupLocation="CenterScreen">
<Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/></Window.InputBindings>
<Grid Background="{DynamicResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
<DockPanel Margin="18,24,18,18">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="App Proxy Bridge" FontSize="22" FontWeight="SemiBold" Margin="6,0,0,6"/><TextBlock Text="让软件的连接，各有去向。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,24"/>
<Button Content="软件" Tag="软件" Click="Navigate" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
<Button Content="代理配置" Tag="代理配置" Click="Navigate" Margin="0,0,0,8"/>
<Button Content="连接记录" Tag="连接记录" Click="Navigate" Margin="0,0,0,8"/>
<TextBlock Text="代理配置列表" Style="{StaticResource Label}"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom">
<Button Content="新增代理配置" Command="{Binding AddProfileCommand}" Margin="0,12,0,8"/>
<Button Content="设置" Tag="设置" Click="Navigate" Margin="0,0,0,8"/>
<TextBlock Text="外观 · System / Light / Dark" Style="{StaticResource Label}"/>
<ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="外观主题"/>
<TextBlock Text="{Binding VersionText}" FontSize="10" Margin="4,14,0,0" Foreground="{DynamicResource MutedBrush}"/>
</StackPanel>
<ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="代理配置列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
</ListBox></DockPanel></Border>
<DockPanel Grid.Column="1">
<Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,16">
<StackPanel><DockPanel><TextBlock Text="运行状态" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="正在处理…" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel><TextBlock Text="{Binding Runtime}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,6"/><TextBlock Text="{Binding ActiveText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
</Border>
<Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
<StackPanel><DockPanel><TextBlock Text="连接控制" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding PendingText}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></DockPanel><TextBlock Text="{Binding Message}" FontSize="12" Margin="0,8,0,10" Foreground="{DynamicResource MutedBrush}"/>
<WrapPanel IsEnabled="{Binding Available}"><Button Content="测试代理" Command="{Binding TestCommand}"/><Button Content="应用更改 / 启用代理" Style="{StaticResource Primary}" Command="{Binding ApplyCommand}"/><Button Content="停止代理" Command="{Binding StopCommand}"/></WrapPanel>
</StackPanel></Border>
<Grid Margin="24,20">
<DockPanel Visibility="{Binding SoftwareVisible,Converter={StaticResource BoolVisibility}}">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="软件" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="勾选的软件共用当前代理；未勾选的软件正常联网。" FontSize="12" Margin="0,8,0,18" Foreground="{DynamicResource MutedBrush}"/>
<WrapPanel Margin="0,0,0,14" IsEnabled="{Binding Available}"><Button Content="选择 EXE" Command="{Binding AddExeCommand}"/><Button Content="正在运行…" Command="{Binding AddRunningCommand}"/><Button Content="开始菜单…" Command="{Binding AddMenuCommand}"/><Button Content="刷新状态" Command="{Binding RefreshAppsCommand}"/></WrapPanel></StackPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><WrapPanel IsEnabled="{Binding Available}"><Button Content="添加辅助程序" Command="{Binding AddComponentCommand}"/><Button Content="启动选中软件" Command="{Binding LaunchCommand}"/><Button Content="移除软件" Command="{Binding RemoveAppCommand}"/></WrapPanel><TextBlock Text="辅助程序需要单独添加。已有连接保留原路径；首次接入时建议让软件重新连接。" FontSize="11" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
<DataGrid x:Name="SoftwareGrid" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedSoftware}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" AutomationProperties.Name="软件列表">
<DataGrid.Columns>
<DataGridTemplateColumn Header="代理" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="软件" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4,8"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="程序路径 / 组件" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Paths}" ToolTip="{Binding Paths}" FontSize="11" Margin="4,8" TextTrimming="CharacterEllipsis" MaxHeight="62"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="状态" Binding="{Binding State}" Width="105"/><DataGridTextColumn Header="连接" Binding="{Binding Connections}" Width="48"/>
</DataGrid.Columns></DataGrid>
</DockPanel>
<DockPanel Visibility="{Binding ProfileVisible,Converter={StaticResource BoolVisibility}}">
<DockPanel.Resources>
<Style x:Key="ProfileCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0"/></Style>
<Style x:Key="ProfileLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}"><Setter Property="Margin" Value="0,8,0,5"/></Style>
</DockPanel.Resources>
<StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" IsEnabled="{Binding Available}"><WrapPanel Margin="0,0,0,8"><Button Content="保存配置" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/><Button Content="复制" Command="{Binding DuplicateCommand}"/><Button Content="设为默认" Command="{Binding DefaultCommand}"/><Button Content="删除" Command="{Binding DeleteProfileCommand}"/></WrapPanel><TextBlock Text="{Binding EditorState}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
<TextBlock DockPanel.Dock="Top" Text="代理配置" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
<ScrollViewer x:Name="ProfileScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel IsEnabled="{Binding Available}">
<Border Style="{StaticResource ProfileCard}"><StackPanel><TextBlock Text="基本配置" FontWeight="SemiBold" FontSize="16"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,10,0"><TextBlock Text="配置名称" Style="{StaticResource ProfileLabel}"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="配置名称"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="协议" Style="{StaticResource ProfileLabel}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.Name="代理协议"/></StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="代理地址" Style="{StaticResource ProfileLabel}"/><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理地址"/></StackPanel>
<StackPanel Grid.Column="3"><TextBlock Text="端口" Style="{StaticResource ProfileLabel}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理端口"/></StackPanel></Grid>
<TextBlock Text="支持 IP 和域名；HTTPS 表示到代理服务器的连接使用 TLS。" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
</StackPanel></Border>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource ProfileCard}"><StackPanel><DockPanel><CheckBox DockPanel.Dock="Right" Content="启用账号密码" IsChecked="{Binding Authentication}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBlock Text="身份认证" FontSize="16" FontWeight="SemiBold"/></DockPanel>
<Grid IsEnabled="{Binding Authentication}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,10,0"><TextBlock Text="账号" Style="{StaticResource ProfileLabel}"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="代理账号"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="密码" Style="{StaticResource ProfileLabel}"/><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" AutomationProperties.Name="代理密码"/></StackPanel></Grid>
<TextBlock Text="密码由当前 Windows 用户加密保存，导出时不包含密码。" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource ProfileCard}"><StackPanel><TextBlock Text="连接测试" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="HTTPS 测试地址" Style="{StaticResource ProfileLabel}"/><TextBox Text="{Binding TestUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="测试地址"/>
<DockPanel Margin="0,8,0,0"><TextBox DockPanel.Dock="Right" Text="{Binding Timeout,UpdateSourceTrigger=PropertyChanged}" Width="76" AutomationProperties.Name="连接超时"/><TextBlock Text="超时（秒，3–120）" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
</Grid>
<ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Margin="0,3" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer></DockPanel>
<DockPanel Visibility="{Binding ConnectionsVisible,Converter={StaticResource BoolVisibility}}">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="连接记录" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="实时连接最多显示 400 条；事件保留最近 500 条。新记录会自动刷新。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16"/></StackPanel>
<TabControl Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
<TabItem Header="实时代理连接"><DataGrid ItemsSource="{Binding Flows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="软件" Binding="{Binding Process}" Width="140"/><DataGridTextColumn Header="目标" Binding="{Binding Host}" Width="*"/><DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/><DataGridCheckBoxColumn Header="UDP" Binding="{Binding Udp}" Width="48"/><DataGridTextColumn Header="上传字节" Binding="{Binding Sent}" Width="85"/><DataGridTextColumn Header="下载字节" Binding="{Binding Received}" Width="85"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="事件与诊断"><DataGrid ItemsSource="{Binding Events}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time,StringFormat=HH:mm:ss}" Width="75"/><DataGridTextColumn Header="软件" Binding="{Binding Process}" Width="120"/><DataGridTextColumn Header="目标" Binding="{Binding Destination}" Width="150"/><DataGridTextColumn Header="结果" Binding="{Binding Action}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
</TabControl></DockPanel>
<ScrollViewer Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="设置" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,16"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="配置与迁移" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding DataDirectory}" Margin="0,10" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><WrapPanel><Button Content="导入旧项目配置" Command="{Binding ImportCommand}"/><Button Content="导出配置（不含密码）" Command="{Binding ExportCommand}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行方式" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="关闭窗口后继续驻留托盘。停止或退出会释放流量接管；电脑重启后服务保持待机，需要手动启用。" Margin="0,12,0,8"/><TextBlock Text="选中软件的上游连接失败时不自动直连；整个引擎退出后恢复系统联网。Windows 共享 DNS、未添加的辅助进程和生效前已有连接不保证经代理。" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="关于" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="独立第三方工具，不提供代理节点。首次使用需要安装后台服务和可用的 WinDivert 驱动。" Margin="0,12,0,8"/><TextBlock Text="未修改系统代理、默认路由或系统 DNS。实际软件的兼容性以验证记录为准。" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
</StackPanel></ScrollViewer>
</Grid></DockPanel></Grid>
</Window>
